<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Intentionally empty. The agent is an unprivileged LaunchAgent:
		no root, no sandbox, hardened runtime with no exceptions.
		Mach service registration is provided by launchd via SMAppService,
		so no XPC-related entitlement is required (see LIFECYCLE_CONTRACT.md).
	-->
</dict>
</plist>
